.passport {
  display: flex;
  flex-direction: column;
  gap: 20px;
  padding: 20px 24px;
  background: var(--fg-surface-elevated, #10131a);
  border-radius: 16px;
  border: 1px solid var(--fg-border-color, rgba(255, 255, 255, 0.08));
}

.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}

.summary {
  display: flex;
  align-items: center;
  gap: 16px;
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--fg-avatar-bg, rgba(107, 114, 128, 0.16));
  color: var(--fg-avatar-text, #ffffff);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.tickerBlock {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.ticker {
  font-size: 24px;
  font-weight: 600;
  color: var(--fg-text-primary, #ffffff);
}

.metaLine {
  font-size: 14px;
  color: var(--fg-text-secondary, #96a1b3);
}

.pulseWrapper {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 80px;
  max-width: 80px;
  flex-shrink: 0;
  overflow: hidden;
}

.metaSection {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.divider {
  height: 1px;
  background: var(--fg-divider, rgba(255, 255, 255, 0.12));
  border: 0;
}

.metaGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 16px;
}

.metaColumn {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.metaLabel {
  font-size: 13px;
  font-weight: 500;
  color: var(--fg-text-muted, #7a8498);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.metaValue {
  font-size: 16px;
  font-weight: 500;
  color: var(--fg-text-primary, #ffffff);
}

.ctaRow {
  display: flex;
  gap: 8px;
}

.ctaButton,
.ctaButtonSecondary {
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
  text-align: center;
  font-size: 13px;
  line-height: 1.2;
  font-weight: 600;
  padding: 6px 8px;
  border-radius: 6px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border 0.2s ease;
}

.ctaButton {
  background: var(--fg-accent-bg, #2563eb);
  color: var(--fg-accent-fg, #ffffff);
  border: none;
}

.ctaButtonSecondary {
  background: transparent;
  color: var(--fg-text-primary, #1a1d29);
  border: 1px solid rgba(0, 0, 0, 0.15);
}

.ctaButtonSecondary:hover {
  background: rgba(37, 99, 235, 0.12);
}

.compact {
  padding: 8px 12px 10px;
  border-radius: 8px;
  width: 220px;
  max-width: 220px;
  min-width: 0;
  box-sizing: border-box;
  flex: 0 0 auto;
  gap: 10px;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  color: #1a1d29;
}

.compact .metaLine {
  font-size: 12px;
  line-height: 1.2;
  color: rgba(26, 29, 41, 0.6);
}

.compact .ticker {
  font-size: 20px;
  color: #1a1d29;
}

.compact .pulseWrapper {
  transform: none;
  transform-origin: top right;
}

.compact .metaSection {
  gap: 6px;
}

.compact .metaGrid {
  row-gap: 4px;
  column-gap: 16px;
}

.compact .metaColumn {
  min-width: 0;
}

.compact .metaLabel {
  color: rgba(26, 29, 41, 0.6);
  font-size: 12px;
  line-height: 1.2;
  font-weight: 500;
}

.compact .metaValue {
  color: #1a1d29;
  font-size: 13px;
  line-height: 1.3;
  font-weight: 600;
}

.compact .ctaRow {
  margin-top: 8px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}
